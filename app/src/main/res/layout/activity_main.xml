<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Truco Score Board"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TeamA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team A"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/TeamB" />

    <TextView
        android:id="@+id/textScoreA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/TeamA"
        app:layout_constraintStart_toStartOf="@id/TeamA"
        app:layout_constraintEnd_toEndOf="@id/TeamA" />

    <TextView
        android:id="@+id/TeamB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team B"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textScore"
        app:layout_constraintStart_toEndOf="@id/TeamA"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textScoreB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/TeamB"
        app:layout_constraintStart_toStartOf="@id/TeamB"
        app:layout_constraintEnd_toEndOf="@id/TeamB" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#D32F2F"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textScoreA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnIncrement1A"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+1"
        android:textSize="20sp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnIncrement1B" />

    <Button
        android:id="@+id/btnIncrement1B"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+1"
        android:textSize="20sp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toEndOf="@id/btnIncrement1A"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnIncrement3A"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+3"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnIncrement1A"
        app:layout_constraintStart_toStartOf="@id/btnIncrement1A"
        app:layout_constraintEnd_toEndOf="@id/btnIncrement1A" />

    <Button
        android:id="@+id/btnIncrement3B"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+3"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnIncrement1B"
        app:layout_constraintStart_toStartOf="@id/btnIncrement1B"
        app:layout_constraintEnd_toEndOf="@id/btnIncrement1B" />

    <Button
        android:id="@+id/btnReset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnIncrement3A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>